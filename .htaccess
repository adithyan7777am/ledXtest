# Apache / LiteSpeed (Hostinger) — generated by tools/build.mjs, do not edit by hand.
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html
ServerSignature Off

RewriteEngine On
# HTTPS everywhere, and one canonical host (no www)
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# Never serve private files, build tools, git data or any dotfile (the brochure PDFs, signing key and lead log live in /private)
RewriteRule ^(private|tools|node_modules|\.git|\.claude)(/|$) - [F,L]
RewriteRule (^|/)\.(?!well-known/) - [F,L]
<FilesMatch "^(package(-lock)?\.json|vercel\.json|_redirects|README\.md|.*\.mjs|.*\.(log|csv|key|eml|bak|sql))$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# 301s from the old Leaf Digital Academy URL structure
RewriteRule ^ai-integrated-digital-marketing-program/?$ /programs/ai-integrated-digital-marketing-program/ [R=301,L]
RewriteRule ^advanced-certificate-in-seo-strategy-execution/?$ /programs/advanced-certificate-in-seo-strategy-execution/ [R=301,L]
RewriteRule ^wordpress-development-certificate-program/?$ /programs/wordpress-development-certificate-program/ [R=301,L]
RewriteRule ^leaf-digital-academy-digital-marketing-skills/?$ /blog/leaf-digital-academy-digital-marketing-skills/ [R=301,L]
RewriteRule ^digital-marketing-easy-for-beginners/?$ /blog/digital-marketing-easy-for-beginners/ [R=301,L]
RewriteRule ^qualifications-for-digital-marketing/?$ /blog/qualifications-for-digital-marketing/ [R=301,L]
RewriteRule ^digital-marketing-tools-for-beginners-2/?$ /blog/career-opportunities-after-digital-marketing-course/ [R=301,L]
RewriteRule ^digital-marketing-tools-for-beginners/?$ /blog/digital-marketing-tools-for-beginners/ [R=301,L]
RewriteRule ^courses-after-pu-to-start-earning-early/?$ /blog/courses-after-pu-to-start-earning-early/ [R=301,L]
RewriteRule ^why-digital-marketing-is-best-career-2026/?$ /blog/why-digital-marketing-is-best-career-2026/ [R=301,L]
RewriteRule ^high-income-skills-after-pu/?$ /blog/high-income-skills-after-pu/ [R=301,L]
RewriteRule ^traditional-degree-skill-course-mangalore/?$ /blog/traditional-degree-skill-course-mangalore/ [R=301,L]

# Security headers (the Content-Security-Policy is defined in tools/security.mjs)
<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://cdn.simpleicons.org; media-src 'self'; frame-src https://www.google.com https://maps.google.com; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always unset X-Powered-By
</IfModule>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json application/xml image/svg+xml text/plain
</IfModule>

# Caching: pictures, video and fonts for a week; CSS/JS are re-checked on every visit (the files are not renamed per release,
# so a long cache would keep visitors on an old version after you update the site).
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 7 days"
  ExpiresByType image/jpeg "access plus 7 days"
  ExpiresByType image/png "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 7 days"
  ExpiresByType video/mp4 "access plus 7 days"
  ExpiresByType font/woff2 "access plus 30 days"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
